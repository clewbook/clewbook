*:Zone.Identifier

# Wallet identity files (contain the seed phrase, encrypted)
*.age

# Wallet folders (keys, viewing keys, wallet database)
campaign/
bidder/
outsider/
viewer/

# Spike run outputs (signed tickets, logs)
spikes/out/

